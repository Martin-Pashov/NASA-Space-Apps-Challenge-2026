# Copy to .env and fill in. Every value is optional: without it that feature degrades gracefully.

# Copernicus Data Space (Sentinel-2 / Sentinel-1 Statistical API). https://dataspace.copernicus.eu
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Twilio for alert SMS and automated voice calls. Without these, messages go to data/outbox.json (dry run).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number in E.164 format, e.g. +15551234567
TWILIO_FROM=

# Optional
# PORT=3000
# FIELDSHIFT_CACHE_DIR=data/cache   # where cached API responses live
# FIELDSHIFT_DATA_DIR=data          # monitor.json and outbox.json
# FIELDSHIFT_NO_LISTEN=1            # import server.js without starting the HTTP server
